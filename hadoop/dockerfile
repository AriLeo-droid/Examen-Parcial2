# Imagen base
FROM debian:bookworm-slim

# Evita preguntas interactivas
ENV DEBIAN_FRONTEND=noninteractive

# Instalar dependencias
RUN apt-get update && apt-get install -y \
    openjdk-17-jdk \
    python3 \
    python3-pip \
    openssh-server \
    openssh-client \
    wget \
    curl \
    tar \
    procps \
    && rm -rf /var/lib/apt/lists/*

# Variables Java
ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64

# Hadoop
ENV HADOOP_VERSION=3.3.6

RUN wget https://archive.apache.org/dist/hadoop/common/hadoop-${HADOOP_VERSION}/hadoop-${HADOOP_VERSION}.tar.gz && \
    tar -xzf hadoop-${HADOOP_VERSION}.tar.gz -C /opt && \
    mv /opt/hadoop-${HADOOP_VERSION} /opt/hadoop && \
    rm hadoop-${HADOOP_VERSION}.tar.gz

# Variables Hadoop
ENV HADOOP_HOME=/opt/hadoop

# PATH
ENV PATH=$PATH:$JAVA_HOME/bin:$HADOOP_HOME/bin:$HADOOP_HOME/sbin

# Configuración SSH
RUN mkdir -p /run/sshd

# Generar host keys del servidor SSH
RUN ssh-keygen -A

# Crear usuario Hadoop
RUN useradd -ms /bin/bash hadoop

# Configurar JAVA_HOME para Hadoop
RUN echo "export JAVA_HOME=${JAVA_HOME}" >> /opt/hadoop/etc/hadoop/hadoop-env.sh

# Configurar acceso SSH sin contraseña para Hadoop
RUN mkdir -p /home/hadoop/.ssh && \
    ssh-keygen -t rsa -N "" -f /home/hadoop/.ssh/id_rsa && \
    cat /home/hadoop/.ssh/id_rsa.pub >> /home/hadoop/.ssh/authorized_keys && \
    chmod 700 /home/hadoop/.ssh && \
    chmod 600 /home/hadoop/.ssh/id_rsa && \
    chmod 600 /home/hadoop/.ssh/authorized_keys && \
    chown -R hadoop:hadoop /home/hadoop/.ssh

# Directorio de trabajo
WORKDIR /workspace

# Mantener root para que sshd pueda arrancar
CMD ["/usr/sbin/sshd","-D"]
